[Unit]
Description=InfoStation after-the-bell recap video (17:00 New York time, Mon–Fri)

[Timer]
# Exchange time: 16:00 ET close, after-hours earnings land 16:05–16:30. 17:00 ET = 14:00 Los Angeles.
# Holidays are handled by the pipeline (auto session → nothing new to do → exits quickly).
OnCalendar=Mon..Fri 17:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
