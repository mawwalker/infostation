[Unit]
Description=InfoStation pre-market X brief (07:30 New York time, Mon–Fri)

[Timer]
# 07:30 ET = 04:30 Los Angeles; ready in ~5 minutes, post before the 09:30 ET open.
OnCalendar=Mon..Fri 07:30 America/New_York
Persistent=true
Unit=infostation-premarket.service

[Install]
WantedBy=timers.target
