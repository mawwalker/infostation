# 复制为 .env 后填写。全部可选，除了 SEC_USER_AGENT。

# 必填：SEC 要求 User-Agent 带联系邮箱，否则会被封 IP。格式：“名字 邮箱”
SEC_USER_AGENT="InfoStation yourname@example.com"

# 可选：Finnhub 免费 Key（https://finnhub.io/register），用于补充公司新闻
FINNHUB_API_KEY=

# 可选：Reddit script 类型 App（https://www.reddit.com/prefs/apps），没有就只用 ApeWisdom + Stocktwits
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# 可选：X API v2 recent search。不填则跳过（doctor / review 里显示 skipped），由 agent 写 runs/<id>/inputs/x_posts.json
# X_BEARER_TOKEN=

# 可选：LLM 后端。agy（默认）或 grokbot（文件交接，见 docs/GROKBOT.md）。也可以用命令行 --llm
# INFOSTATION_LLM=grokbot

# 可选：网络代理（访问 Google News / Yahoo 等）
# HTTPS_PROXY=http://127.0.0.1:7890

# 可选：全自动运行时，失败后让 agy 按 infostation-daily 技能自动排查、修复并续跑一次（会以跳过权限确认的方式运行 agy）
# AUTO_FIX=1
# 可选：完成/失败时调用的通知脚本，参数为 <ok|failed> <消息>，可用来推送到 Telegram / 企业微信等
# NOTIFY_SCRIPT=/home/you/bin/notify.sh
